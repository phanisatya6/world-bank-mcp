# LLM provider: "groq" (default) or "gemini".
# Leave blank to auto-detect: Gemini is used when only GEMINI_API_KEY is set.
# LLM_PROVIDER=groq

# --- Groq (free key: https://console.groq.com/keys) ---
# Tool-calling models available on the free tier include:
#   openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free key: https://aistudio.google.com/apikey) ---
# Uses Gemini's OpenAI-compatible endpoint, so no other code changes are needed.
# Set LLM_PROVIDER=gemini (or leave GROQ_API_KEY empty) to activate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Optional: any other OpenAI-compatible endpoint (for example Ollama) ---
# GROQ_BASE_URL=http://localhost:11434/v1

# --- Optional agent tuning ---
# Free tiers cap tokens per minute, so the client keeps the conversation under a
# budget and trims older tool results. Lower MAX_CONTEXT_TOKENS if you hit 429s.
# AGENT_MAX_ITERATIONS=6
# AGENT_TEMPERATURE=0.1
# AGENT_MAX_TOKENS=2048
# MAX_CONTEXT_TOKENS=6000
# MAX_TOOL_RESULT_CHARS=12000
# MAX_ABSTRACT_CHARS=320
